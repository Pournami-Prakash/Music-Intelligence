# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=music-intelligence-atlas
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ── Spotify ───────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SP_DC cookie — only needed for charts.spotify.com scraping (optional)
SPOTIFY_SP_DC=
SPOTIFY_USERNAME=
SPOTIFY_PASSWORD=

# ── Last.fm ───────────────────────────────────────────────────────────────────
LASTFM_API_KEY=
LASTFM_API_SECRET=

# ── ListenBrainz ─────────────────────────────────────────────────────────────
# Required by compute_listenbrainz_full.py and related scripts
LISTENBRAINZ_TOKEN=

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=

# ── Genius ────────────────────────────────────────────────────────────────────
GENIUS_ACCESS_TOKEN=

# ── Deezer (no key required for public API) ───────────────────────────────────
DEEZER_API_BASE=https://api.deezer.com

# ── Server ────────────────────────────────────────────────────────────────────
# Production frontend URL — added to CORS allowed origins.
# Leave blank in local dev; the localhost origins are always allowed.
FRONTEND_URL=https://pournamiprakash.dev

# Optional hosted LLM used by /api/soundtrack-gift. If unset or rate-limited,
# the API falls back to keyword classification.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Set to 1 on free/serverless-style hosts so startup does not eagerly load
# FAISS and large parquet artifacts.
SKIP_STARTUP_WARMUP=0

# ── Local paths ───────────────────────────────────────────────────────────────
# Absolute path to the Million Playlist Dataset "data/" folder
MPD_DIR=/path/to/spotify_million_playlist_dataset/data

# ── Upstash Vector (track2vec similarity for Doppelganger / Transition) ───────
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
