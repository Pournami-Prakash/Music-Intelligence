# ── Data (never commit raw or processed parquets) ────────────────────────────
data/
!frontend/src/data/
!frontend/src/data/**
# Precomputed snapshot JSON IS shipped with the frontend (served as static
# assets by Vercel); the pages 404 without it, so it must be tracked.
!frontend/public/data/
!frontend/public/data/**

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Large model/vector files ──────────────────────────────────────────────────
*.pt
*.bin
*.pkl
*.faiss
*.npy

# ── Logs & process output ─────────────────────────────────────────────────────
logs/
nohup.out
*.log

# ── IDE & editor ──────────────────────────────────────────────────────────────
.claude/
.vscode/
.idea/
.impeccable.md

# ── Test cache ────────────────────────────────────────────────────────────────
.pytest_cache/

# ── Frontend build ────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# ── Alteryx ───────────────────────────────────────────────────────────────────
alteryx/*.yxdb
alteryx/*.yxmd
