# Auto-HTTPS reverse proxy for the FastAPI backend.
# CORS is handled by FastAPI (CORSMiddleware, driven by the FRONTEND_URL env var)
# — do NOT also set CORS headers here, or the browser sees duplicate
# Access-Control-Allow-Origin values and rejects the response.
api.pournamiprakash.dev {
    reverse_proxy localhost:8000
    header -Server
}
